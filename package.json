{
  "name": "bluey",
  "private": true,
  "version": "0.1.0",
  "description": "Personal Codex skills and MCP servers.",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=26.8.2 <27",
    "pnpm": ">=12"
  },
  "scripts": {
    "preinstall": "node scripts/verify-toolchain.mjs",
    "build": "turbo run build",
    "check": "pnpm build && pnpm test",
    "test": "pnpm test:toolchain && turbo run test",
    "test:toolchain": "vitest run scripts/verify-toolchain.test.mjs",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^12.0.0",
    "@types/node": "^24.0.0",
    "tsdown": "^0.20.1",
    "turbo": "^2.8.5",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
